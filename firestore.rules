rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if resource.data.aktif == true || isAdmin();
      allow write: if isAdmin();
    }

    match /gallery/{galleryId} {
      allow read: if resource.data.tampil_di_home == true || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.before_url is string
        && request.resource.data.after_url is string
        && request.resource.data.before_url.matches('https://res[.]cloudinary[.]com/.*')
        && request.resource.data.after_url.matches('https://res[.]cloudinary[.]com/.*');
      allow delete: if isAdmin();
    }

    match /testimonials/{testiId} {
      allow read: if resource.data.tampil == true || isAdmin();
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
